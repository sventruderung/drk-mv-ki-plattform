# =============================================================================
# DRK MV KI-Plattform — Umgebungsvariablen (Vorlage, KEINE echten Werte!)
# Kopiere diese Datei nach .env und fülle die Werte aus.
# WICHTIG: .env niemals committen (steht in .gitignore)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=drk_platform
POSTGRES_USER=drk_app
POSTGRES_PASSWORD=CHANGE_ME

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=drk-mv
KEYCLOAK_CLIENT_ID=drk-platform
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:32b

# --- LiteLLM ---
LITELLM_BASE_URL=http://llm-service:4000
LITELLM_API_KEY=CHANGE_ME

# --- Services ---
API_GATEWAY_PORT=8000
RAG_SERVICE_PORT=8001
LLM_SERVICE_PORT=8002
ADMIN_SERVICE_PORT=8003

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
