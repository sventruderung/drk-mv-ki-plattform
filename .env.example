# =============================================================================
# DRK MV KI-Plattform — Umgebungsvariablen (Vorlage, KEINE echten Werte!)
# Kopiere diese Datei nach .env und fülle die Werte aus.
# WICHTIG: .env niemals committen (steht in .gitignore)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=drk_platform
POSTGRES_USER=drk_app
POSTGRES_PASSWORD=CHANGE_ME

# --- HTTPS (Caddy + Let's Encrypt) ---
# Kontakt für Zertifikats-Benachrichtigungen; der Hostname selbst wird
# im Admin-UI gepflegt (Tab Einstellungen) — Änderung wirkt ohne Neustart.
ACME_EMAIL=CHANGE_ME@example.org

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080/auth
# Öffentliche URL für Browser-Redirects (hinter Caddy), z.B. https://ki.kv-name.drk.de/auth
KEYCLOAK_PUBLIC_URL=https://CHANGE_ME/auth
KEYCLOAK_REALM=drk-kv
KEYCLOAK_CLIENT_ID=drk-platform
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
# DGX Spark: Qwen3 32B Q4 (~20 GB) — vorher: ollama pull qwen3:32b
OLLAMA_DEFAULT_MODEL=qwen3:32b
# Embedding für RAG (768 Dimensionen) — vorher: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# --- MinIO (Original-Dokumente) ---
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=drk-docs

# --- Services ---
API_GATEWAY_PORT=8000
RAG_SERVICE_PORT=8001
LLM_SERVICE_PORT=8002
ADMIN_SERVICE_PORT=8003
CONTENT_SERVICE_PORT=8005

# --- ELO-DMS-Connector ---
# Interner Hostname des ELO-Servers + dessen feste IP. Sorgt dafür, dass der
# Connector den .local-Namen auch ohne KV-DNS auflöst (reboot-/update-fest).
ELO_SERVER_HOST=elo-srv.drkkvdbr.local
ELO_SERVER_IP=

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
