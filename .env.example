# =============================================================================
# DRK MV KI-Plattform — Umgebungsvariablen (Vorlage, KEINE echten Werte!)
# Kopiere diese Datei nach .env und fülle die Werte aus.
# WICHTIG: .env niemals committen (steht in .gitignore)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=drk_platform
POSTGRES_USER=drk_app
POSTGRES_PASSWORD=CHANGE_ME

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
# Öffentliche URL für Browser-Redirects (Open WebUI OIDC), z.B. https://ki.kv-name.drk.de/auth
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=drk-kv
KEYCLOAK_CLIENT_ID=drk-platform
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
# DGX Spark: Qwen3 72B Q4 (~42 GB) — vorher: ollama pull qwen3:72b
OLLAMA_DEFAULT_MODEL=qwen3:72b
# Embedding für RAG (768 Dimensionen) — vorher: ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# --- MinIO (Original-Dokumente) ---
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=drk-docs

# --- Services ---
API_GATEWAY_PORT=8000
RAG_SERVICE_PORT=8001
LLM_SERVICE_PORT=8002
ADMIN_SERVICE_PORT=8003

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=development
